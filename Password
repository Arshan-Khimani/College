/*
Pseudocode:

1. Include necessary libraries for input/output, string manipulation, and random number generation.
2. Define a constant string containing special characters for password generation.
3. Define a function `randomChar(charSet)`:
   - This function takes a string of characters as input.
   - Generate a random index based on the length of `charSet`.
   - Return the character at that random index.
4. Define a function `generatePassword(minLength, maxLength, minLower, minUpper, minDigits, minSpecial)`:
   - Calculate the total required length based on the minimum character requirements.
   - If `minLength` is greater than `maxLength` or if required length exceeds `maxLength`, return "invalid".
   - Determine the actual password length, ensuring it meets the minimum length and required length.
   - Initialize an empty string to hold the generated password.
   - Loop to add `minLower` number of random lowercase letters to the password.
   - Loop to add `minUpper` number of random uppercase letters to the password.
   - Loop to add `minDigits` number of random digits to the password.
   - Loop to add `minSpecial` number of random special characters to the password.
   - While the password length is less than the determined password length, append random characters from all allowed character sets.
   - Shuffle the characters in the password to enhance randomness.
   - Return the final generated password.
5. In the `main()` function:
   - Seed the random number generator using the current time to ensure different outputs in each run.
   - Declare integer variables to store user inputs for password constraints.
   - Prompt the user to enter values for minimum length, maximum length, and character requirements.
   - Read the user inputs into the respective variables.
   - Generate and print a password based on the user inputs.
   - Generate and print a password with fixed parameters for testing.
   - Return 0 to indicate successful execution of the program.
*/

#include <iostream>
#include <string>
#include <cstdlib>
#include <ctime>

using namespace std;

// Define a constant string containing special characters for password generation.

const string specials = "!@#$%^&*+:;";

// Function declaration: Returns a random character from the given character set.

char randomChar(const string &charSet) 
{
    // Generate a random index based on the length of the character set and return the character at that index.
    
    return charSet[rand() % charSet.length()];
}

// Function to generate a password with specific constraints.

string generatePassword(int minLength, int maxLength, int minLower, int minUpper, int minDigits, int minSpecial) 
{
    // Calculate the total required length based on minimum character requirements.
    
    int requiredLength = minLower + minUpper + minDigits + minSpecial;
    
    // Check if the minimum length exceeds the maximum length or if the required length is greater than the maximum length.
    
    if (minLength > maxLength || requiredLength > maxLength) 
    {
        // Return invalid if the length constraints are not satisfied.
        
        return "invalid";
    }
    
    // Determine the actual password length, ensuring it meets the minimum length and required length.
    
    size_t passwordLength = max(static_cast<size_t>(minLength), static_cast<size_t>(requiredLength));
    
    // Initialize an empty string to hold the generated password.
    
    string password;
    
    // Loop to add the minimum required number of lowercase letters to the password.
    
    for (int i = 0; i < minLower; i++) 
    {
        // Append a random lowercase letter to the password.
        
        password += randomChar("abcdefghijklmnopqrstuvwxyz");
    }
    
    // Loop to add the minimum required number of uppercase letters to the password.
    
    for (int i = 0; i < minUpper; i++) 
    {
        // Append a random uppercase letter to the password.
        
        password += randomChar("ABCDEFGHIJKLMNOPQRSTUVWXYZ");
    }
    
    // Loop to add the minimum required number of digits to the password.
    
    for (int i = 0; i < minDigits; i++) 
    {
        // Append a random digit to the password.
        
        password += randomChar("0123456789");
    }
    
    // Loop to add the minimum required number of special characters to the password.
    
    for (int i = 0; i < minSpecial; i++) 
    {
        // Append a random special character to the password.
        
        password += randomChar(specials);
    }
    
    // While the password length is less than the determined password length, keep adding random characters.
    
    while (password.length() < passwordLength) 
    {
        // Append a random character from all allowed character sets to the password.
        
        password += randomChar("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789" + specials);
    }
    
    // Loop to shuffle the characters in the password to enhance randomness.
    
    for (size_t i = 0; i < password.length(); i++) 
    {
        // Swap the current character with a randomly selected character in the password.
        
        swap(password[i], password[rand() % password.length()]);
    }
    
    // Return the final generated password.
    
    return password;
}

int main() 
{
    // Seed the random number generator with the current time to ensure different outputs each run.
    
    srand(time(0));
    
    // Declare integer variables to store user inputs for password constraints.
    
    int minL, maxL, lower, upper, digits, specialChars;
    
    // Prompt the user to enter the minimum length, maximum length, and minimum character requirements.
    
    cout << "Enter minL, maxL, lower, upper, digits, specials values: ";
    
    // Read the user inputs into the respective variables.
    
    cin >> minL >> maxL >> lower >> upper >> digits >> specialChars;
    
    // Generate and print a password based on the user inputs.
    
    cout << generatePassword(minL, maxL, lower, upper, digits, specialChars) << endl;
    
    // Generate and print a password with fixed parameters for testing.
    
    cout << generatePassword(8, 10, 2, 2, 2, 2) << endl;
   
    return 0;
}
