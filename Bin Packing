#include <iostream>
#include <sstream>
#include <string>

using namespace std;

const int MAXITEMS = 100;
int items[MAXITEMS], bins[MAXITEMS];
int numItems=0; 

int binPacking() 
{
    int numBins = 0;  

    for (int i = 0; i < numItems; i++) 
    {
        bool placed = false;

        for (int j = 0; j < numBins; j++) 
        {
            if (bins[j] + items[i] <= 100) 
            {
                bins[j] += items[i];  
                placed = true;
                
                break;
            }
        }

        if (!placed) 
        {
            bins[numBins] = items[i];
            numBins++;
        }
    }

    return numBins;  
}

int main()
{
   string line;

   getline(cin, line);  
   istringstream istr(line);  

   while (istr >> items[numItems]) 
      numItems++;

   int numBins = binPacking();
   
   cout << "# of bins: " << numBins << endl;
   
   for(int i=0; i<numBins; i++)
      cout << bins[i] << " ";
}
