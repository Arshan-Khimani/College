#include <iostream>
#include "RectangleFromGO.h"
#include "CircleFromGO.h"
#include <iostream>

using namespace std;

int main()
{
    // Create a CircleFromGO object with radius 5.3, color "Blue", and filled true
    CircleFromGO circle(5.3, "Blue", true);
    
    // Print circle information
    circle.print();
    
    // Output the color of the circle
    cout << "The color is " <<  circle.getColor() << endl;

    // Output whether the circle is filled
    cout << "The color filled is " <<  circle.getFilled() << endl;

    // Output the radius of the circle
    cout << "The radius is " <<  circle.getRadius() << endl;

    // Output the area of the circle
    cout << "The area is " <<  circle.getArea() << endl;

    // Output the diameter of the circle
    cout << "The diameter is " <<  circle.getDiameter() << endl;

    // Output the formatted circle object using overloaded << operator
    cout <<  circle << endl << endl;

    // Create another CircleFromGO object with radius 15.3 using a different constructor
    CircleFromGO circle2(15.3);
    
    // Print circle2 information
    circle2.print();
    
    // Output the color of circle2
    cout << "The color is " <<  circle2.getColor() << endl;

    // Output whether circle2 is filled
    cout << "The color filled is " <<  circle2.getFilled() << endl;
    
    // Set the color of circle2 to "Green"
    circle2.setColor("Green");
    
    // Output the updated color of circle2
    cout << "After setting, the color is " <<  circle2.getColor() << endl;

    // Output the radius of circle2
    cout << "The radius is " <<  circle2.getRadius() << endl;

    // Output the area of circle2
    cout << "The area is " <<  circle2.getArea() << endl;

    // Output the diameter of circle2
    cout << "The diameter is " <<  circle2.getDiameter() << endl;

    // Output the formatted circle2 object
    cout <<  circle2 << endl << endl;

    // Create a CircleFromGO object using the default constructor
    CircleFromGO circle3;
    
    // Print circle3 information
    circle3.print() ;
    
    // Output the color of circle3
    cout << "The color is " <<  circle3.getColor() << endl;

    // Output whether circle3 is filled
    cout << "The color filled is " <<  circle3.getFilled() << endl;

    // Output the radius of circle3
    cout << "The radius is " <<  circle3.getRadius() << endl;

    // Output the area of circle3
    cout << "The area is " <<  circle3.getArea() << endl;

    // Output the diameter of circle3
    cout << "The diameter is " <<  circle3.getDiameter() << endl;
    
    // Set a new radius for circle3
    circle3.setRadius(26.7);
    
    // Set a new color for circle3
    circle3.setColor("Yellow");
    
    // Output the updated formatted circle3 object
    cout << circle3 << endl << endl;

    // Create a RectangleFromGO object with width 27.9, height 15.6, color "Red", not filled
    RectangleFromGO rect1(27.9, 15.6, "Red", false);
    
    // Print rect1 information
    rect1.print();
    
    // Output the color of rect1
    cout << "The color is " <<  rect1.getColor() << endl;

    // Output whether rect1 is filled
    cout << "The color filled is " <<  rect1.getFilled() << endl;

    // Output the width of rect1
    cout << "The width is " <<  rect1.getWidth() << endl;

    // Output the height of rect1
    cout << "The height is " <<  rect1.getHeight() << endl;

    // Output the area of rect1
    cout << "The area is " <<  rect1.getArea() << endl;

    // Output the perimeter of rect1
    cout << "The Perimeter is " <<  rect1.getPerimeter()  << endl;

    // Output the formatted rect1 object
    cout << rect1 << endl << endl;

    // Create another RectangleFromGO object with width 13.2 and height 15.6
    RectangleFromGO rect2(13.2, 15.6);
    
    // Print rect2 information
    rect2.print();
    
    // Output the color of rect2
    cout << "The color is " <<  rect2.getColor() << endl;

    // Output whether rect2 is filled
    cout << "The color filled is " <<  rect2.getFilled() << endl;
   
    // Change the color of rect2 to "Cyan"
    rect2.setColor("Cyan");
   
    // Output the updated color of rect2
    cout << "After setting, the color is " <<  rect2.getColor() << endl;

    // Output the width of rect2
    cout << "The width is " <<  rect2.getWidth() << endl;

    // Output the height of rect2
    cout << "The height is " <<  rect2.getHeight() << endl;

    // Output the area of rect2
    cout << "The area is " <<  rect2.getArea() << endl;

    // Output the perimeter of rect2
    cout << "The Perimeter is " <<  rect2.getPerimeter() << endl;

    // Output the formatted rect2 object
    cout << rect2 << endl << endl;

    // Create a RectangleFromGO object using the default constructor
    RectangleFromGO rect3;
   
    // Print rect3 information
    rect3.print();
 
    // Output the color of rect3
    cout << "The color is " <<  rect3.getColor() << endl;

    // Output whether rect3 is filled
    cout << "The color filled is " <<  rect3.getFilled() << endl;

    // Output the width of rect3
    cout << "The width is " <<  rect3.getWidth() << endl;

    // Output the height of rect3
    cout << "The height is " <<  rect3.getHeight() << endl;

    // Output the area of rect3
    cout << "The area is " <<  rect3.getArea() << endl;

    // Output the perimeter of rect3
    cout << "The Perimeter is " <<  rect3.getPerimeter() << endl;
  
    // Set a new height for rect3
    rect3.setHeight(26.7);
  
    // Set a new width for rect3
    rect3.setWidth(14.98);
  
    // Set a new color for rect3
    rect3.setColor("Indigo");
  
    // Output the updated width of rect3
    cout << "The width is " <<  rect3.getWidth() << endl;

    // Output the updated height of rect3
    cout << "The height is " <<  rect3.getHeight() << endl;

    // Output the updated area of rect3
    cout << "The area is " <<  rect3.getArea() << endl;

    // Output the updated perimeter of rect3
    cout << "The Perimeter is " <<  rect3.getPerimeter() << endl;

    // Output the updated formatted rect3 object
    cout << rect3 << endl << endl;

    return 0;
}

