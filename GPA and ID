// Function to sort arrays by GPA using bubble sort

void modifiedSortGPA(double array1[], int array2[], string array3[], int numElems) 
{
    // Outer loop for each element in the array
    
    for (int i = 0; i < numElems - 1; i++) 
    {
        // Inner loop to compare adjacent elements
        
        for (int j = 0; j < numElems - i - 1; j++) 
        {
            // If the current GPA is greater than the next one
            
            if (array1[j] > array1[j + 1]) 
            {
                // Swap GPA
                
                double tempGPA = array1[j];
                array1[j] = array1[j + 1];
                array1[j + 1] = tempGPA;
                
                // Swap netID
                
                int tempID = array2[j];
                array2[j] = array2[j + 1];
                array2[j + 1] = tempID;
                
                // Swap major
                
                string tempMajor = array3[j];
                array3[j] = array3[j + 1];
                array3[j + 1] = tempMajor;
            }
        }
    }
}

// Function to sort arrays by netID using bubble sort

void modifiedSortID(int array2[], double array1[], string array3[], int numElems) 
{
    // Outer loop for each element
    
    for (int i = 0; i < numElems - 1; i++) 
    {
        // Inner loop to compare adjacent elements
        
        for (int j = 0; j < numElems - i - 1; j++) 
        {
            // If the current netID is greater than the next one
            
            if (array2[j] > array2[j + 1]) 
            {
                // Swap netID
                
                int tempID = array2[j];
                array2[j] = array2[j + 1];
                array2[j + 1] = tempID;
                
                // Swap GPA
                
                double tempGPA = array1[j];
                array1[j] = array1[j + 1];
                array1[j + 1] = tempGPA;
                
                // Swap major
                
                string tempMajor = array3[j];
                array3[j] = array3[j + 1];
                array3[j + 1] = tempMajor;
            }
        }
    }
}

// Linear search for netID

int linearSearchID(int arr[], int numElems, int value, int &nIter) 
{
    // Initialize the iteration counter
    
    nIter = 0;
    
    // Iterate through the array
    
    for (int i = 0; i < numElems; i++) 
    {
        // Increment the iteration counter
        
        nIter++;
        
        // If the value matches the netID at index i
        
        if (arr[i] == value) 
        {
            // Return the index where the value was found
            
            return i;
        }
    }
    
    // Return -1 if the value was not found
    
    return -1;
}

// Binary search for netID

int binarySearchID(int arr[], int numElems, int value, int &nIter) 
{
    // Initialize the iteration counter
    
    nIter = 0;
    
    // Set the initial search range
    
    int low = 0;
    int high = numElems - 1;
    
    // While the range is valid
    
    while (low <= high) 
    {
        // Increment the iteration counter
        
        nIter++;
        
        // Calculate the middle index
        
        int mid = (low + high) / 2;
        
        // If the value is found at the middle index
        
        if (arr[mid] == value) 
        {
            // Return the index
            
            return mid;
        }
        
        // If the value is greater, search the right half
        
        else if (arr[mid] > value) 
        {
            high = mid - 1;
        }
        
        // If the value is smaller, search the left half
        
        else 
        {
            low = mid + 1;
        }
    }
    
    // Return -1 if the value was not found
    
    return -1;
}
