/* This program gets the length of the side of the patio opposite the house and the 
length of one of the sides of the patio perpendicular to the house from the user and 
calculates the total length and the length of the runs to be strung.
*/

#include <iostream>
#include <iomanip>
#include <cmath>

using namespace std;

int main() {
    
  /* Declaring variables oppositeSide, perpendicularSide, totalLength, oppositeRun, 
  perpendicularRun, diagonalRun, and sag as doubles.
  */
  
  double oppositeSide;
  double perpendicularSide;
  double totalLength;
  double oppositeRun;
  double perpendicularRun;
  double diagonalRun;
  double sag = 0.07;

  // Getting input from the user
  
  cout << "Enter the length of the side opposite the house in feet: ";
  cin >> oppositeSide;
  cout << "Enter the length of one of the sides perpendicular to the house in feet: ";
  cin >> perpendicularSide;

  // Calculating the lengths of each run
  
  oppositeRun = oppositeSide;
  perpendicularRun = perpendicularSide;
  diagonalRun = sqrt(pow(oppositeSide, 2) + pow(perpendicularSide, 2)); 

  // Calculating the total length before sag
  
  totalLength = oppositeRun + 2 * perpendicularRun + 2 * diagonalRun;

  // Calculating the lengths of each run including sag
  
  oppositeRun *= (1 + sag);
  perpendicularRun *= (1 + sag);
  diagonalRun *= (1 + sag);

  // Displaying the results of the calculations to the user
  
  cout << fixed << setprecision(4);
  cout << "Total length calculated = " << totalLength << " feet.\n";
  cout << "The length of the run opposite the house including sag = " << oppositeRun << " feet.\n";
  cout << "The length of the two perpendicular runs including sag = " << perpendicularRun << " feet each.\n";
  cout << "The length of the two diagonal runs including sag = " << diagonalRun << " feet each.\n";
  cout << "The total length of the strands needed including sag = " << oppositeRun + 2 * perpendicularRun + 2 * diagonalRun << " feet.\n";

  return 0;
}
