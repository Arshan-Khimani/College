/* This program calculates the distance an object falls in a specified number of seconds when dropped on earth 
or on the moon. */

#include <iostream>
#include <iomanip>

using namespace std;

// Creating a function called getSeconds as type double

double getSeconds()
{
    // Creating a double variable called seconds
    
    double seconds;
    
    // Asking the user to enter the time of the fall in seconds and storing the user input in the variable seconds
    
    cout << "Please enter the time of the fall (in seconds): ";
    cin >> seconds;
    
    // If the seconds entered is less than 0, an error message will be displayed
    
    if(seconds < 0)
    {
        cout << "Error!! the time entered is less than 0. The time must be at least zero." << endl;
    }
    
    // Returning seconds
    
    return seconds;
}

// Creating a function called findEarthFallDist as type double

double findEarthFallDist(double seconds)
{
    // Creating a constant as a double called EARTH_GRAVITY and setting it equal to 9.81
    
    const double EARTH_GRAVITY = 9.81;
    
    // Creating a distanceTravelled variable and setting it equal to the formula of 0.5 * g * t^2
    
    double distanceTravelled = 0.5 * EARTH_GRAVITY * seconds * seconds;
    
    // Returning distanceTravelled
    
    return distanceTravelled;
}

// Creating a function called findMoonFallDist as type double

double findMoonFallDist(double seconds)
{
    // Creating a constant as a double called MOON_GRAVITY and setting it equal to 1.625
    
    const double MOON_GRAVITY = 1.625;
    
    // Creating a distanceTravelled variable and setting it equal to the formula of 0.5 * g * t^2
    
    double distanceTravelled = 0.5 * MOON_GRAVITY * seconds * seconds;
    
    // Returning distanceTravelled
    
    return distanceTravelled;
}

int main()
{
    // Setting the variable seconds equal to the fuction getSeconds
    
    double seconds = getSeconds();
    
    // If the seconds entered is >= 0 these statements will run
    
    if(seconds >= 0)
    {
        // Printing the amount the object traveled in meters along with the time it took. Also made sure to use proper formatting
        
        cout << endl;
        cout << fixed << setprecision(3);
        cout << "The object traveled " << findEarthFallDist(seconds) << " meters in " << setprecision(1) << seconds << " seconds on Earth." << endl;
        cout << "The object traveled " << setprecision(3) << findMoonFallDist(seconds) << " meters in " << setprecision(1) << seconds << " seconds on the Moon." << endl;
    }
    
    return 0;
}

