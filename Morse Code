// This program creates a file containing the Morse code equivalent of the input file. 

#include <iostream>
#include <fstream>
#include <string>

using namespace std;

/* Creating a boolean function called loadMorseArray that loads the Morse code mappings from a file into an array. The parameters 
are: string morseCodes[] and ifstream &morseFile. This function returns a boolean value of either true or false. */

bool loadMorseArray(string morseCodes[], ifstream &morseFile) 
{
    // Creating an integer variable called count and setting it equal to 0
    
    int count = 0;
    
    // Creating string variables called letter and code
    
    string letter, code;
    
    // Reading the Morse code mappings from the file until the end of the file is reached
    
    while (morseFile >> letter >> code) 
    {
        // Storing the Morse code in the array 
        
        morseCodes[count] = code;
        
        // Increamenting count by 1
        
        count++;
    }
    
    // If count is equal to 26, true will be returned
    
    if (count == 26) 
    {
        return true;
    }
    
    // If count is not equal to 26, false will be returned
    
    else 
    {
        return false;
    }
}

/* Creating a void function called genMorse that converts a given string into its Morse code equivalent. The parameters 
are: string &output, const string &input, const string morseCodes[]. This function returns nothing. */

void genMorse(string &output, const string &input, const string morseCodes[]) 
{
    // Initializing the output string to empty
    
    output = "";
    
    // Iterating over each character in the input string
    
    for (int i = 0; i < (int)input.length(); i++) 
    {
        // If the character is upper case, this will run
        
        if (input[i] >= 'A' && input[i] <= 'Z') 
        {
            // Appending the coresponding Morse code
            
            output += morseCodes[input[i] - 'A'];
            
            // Adding a space between Morse code letters
            
            output += " ";
        } 
        
        // If the character is not uppercase, this will run
        
        else 
        {
            // Appending the character to output
            
            output += input[i];
        }
    }
}

int main() 
{
    // Creating string variables called inputFileName, outputFileName, inputLine, morseLine
    
    string inputFileName, outputFileName, inputLine, morseLine;
    
    // Creating an integer variable called linesTranslated and setting it equal to 0
    
    int linesTranslated = 0;

    // Asking the user to enter the name of the input file and storing it in the inputFileName variable
    
    cout << "Enter the name of the input file: ";
    cin >> inputFileName;

    // Asking the user to enter the name of the output file and storing it in the outputFileName variable
    
    cout << "Enter the name of the output file: ";
    cin >> outputFileName;
  
    // Opening the file inputted by the user in the inputFileName variable
    
    ifstream inputFile(inputFileName);

    // Creating an output file stream object named outputFile based on what is in outputFileName
    
    ofstream outputFile(outputFileName);

    // Checking if inputFile cannot be opened
    
    if (!inputFile) 
    {
        // Displaying an error message to the user
        
        cout << "Error, unable to open file " << inputFileName << "." << endl;
        
        // Terminating the program
        
        return 0;
    }

    // Checking if outputFile cannot be opened
    
    if (!outputFile) 
    {
        // Displaying an error message to the user
        
        cout << "Error, unable to open file " << outputFileName << "." << endl;
        
        // Closing the inputFile stream
        
        inputFile.close();
        
        // Terminating the program
        
        return 0;
    }
    
    // Opening the Morse code file called morseLetters.txt
    
    ifstream morseFile("morseLetters.txt");

    // Checking if morseFile cannot be opened
    
    if (!morseFile) 
    {
        // Displaying an error message to the user
        
        cout << "Error, unable to open file morseLetters.txt." << endl;
        
        // Closing the inputFile, and outputFile stream
        
        inputFile.close();
        outputFile.close();
        
        // Terminating the program
        
        return 0;
    }

    // Creating a string array called morseCodes and setting its size to 26
    
    string morseCodes[26];
    
    // This if statement runs if the Morse code is unable to load
    
    if (!loadMorseArray(morseCodes, morseFile)) 
    {
        // Displaying an error message to the user
        
        cout << "Error, unable to load Morse code from morseLetters.txt." << endl;
        
        // Closing the inputFile, outputFile, and morseFile stream
        
        inputFile.close();
        outputFile.close();
        morseFile.close();
        
        // Terminating the program
        
        return 0;
    }

    // Reading each line from the input file
    
    while (getline(inputFile, inputLine)) 
    {
        // Converting the line to Morse code
        
        genMorse(morseLine, inputLine, morseCodes);
        
        // Writing the Morse code to the output file
        
        outputFile << morseLine << endl;
        
        // Increamenting linesTranslated by 1
        
        linesTranslated++;
    }

    // Closing the inputFile, outputFile, and morseFile stream
    
    inputFile.close();
    outputFile.close();
    morseFile.close();

    // If linesTranslated is greater than 0, this message will be displayed
    
    if (linesTranslated > 0) 
    {
        cout << "Translation complete. " << linesTranslated << " lines translated." << endl;
    }

    return 0;
}
