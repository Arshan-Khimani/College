/*
Pseudocode:

1. Start
2. Declare function prototypes for:
   a. Creating and initializing an array with random values
   b. Computing the sum of an array's elements
   c. Printing the contents of an array
3. In the main function:
   a. Declare integer variables for:
      - Array size
      - Random seed
      - Total sum
   b. Loop until a valid array size is entered:
      - Prompt user for array size
      - If the size is invalid (<= 0), display an error message and repeat
   c. Prompt user for the seed value and store it
   d. Create an array using the entered size and seed
   e. If memory allocation fails, print an error message and exit
   f. Print the contents of the array
   g. Compute the sum of the array elements and display it
   h. Deallocate the dynamically allocated memory
   i. End program

4. Function `createArray(size, seed)`:
   a. If size is invalid (<= 0), return nullptr
   b. Set the random seed
   c. Allocate memory for an array of the given size
   d. Fill the array with random numbers between 0 and 19
   e. Return the allocated array

5. Function `printArray(arr, size)`:
   a. If the array is invalid or size is <= 0, return
   b. Iterate through the array using a pointer
   c. Print each element separated by a space
   d. Print a newline at the end

6. Function `sumArray(arr, size)`:
   a. If the array is invalid or size is <= 0, return 0
   b. Initialize sum variable to 0
   c. Iterate through the array using a pointer
   d. Accumulate sum of all elements
   e. Return the computed sum

7. End
*/


#include <iostream>
#include <iomanip>
#include <cstdlib>

using namespace std;

// Function to create and initialize an array with random values

int* createArray(int size, int seed);

// Function to compute the sum of an array's elements

int sumArray(int *arr, int size);

// Function to print the contents of an array

void printArray(int* arr, int size);

int main() 
{
    // Declare integer variables for array size, random seed, and total sum
    
    int size, seed, total;

    // Loop to ensure valid array size input from the user
    
    do 
    {
        // Prompt user for array size and store it in the size variable
        
        cout << "Enter the size of the array: ";
        cin >> size;

        // Check if the entered size is invalid
         
        if (size <= 0) 
        {
            // Inform the user of invalid input
            
            cout << "Array size must be greater than 0." << endl;
        }
    } while (size <= 0);    // Repeat until a valid size is entered

    // Prompt user for random seed value and read seed value from user input
    
    cout << "\nEnter the seed value: ";
    cin >> seed;

    // Create array of given size using values entered by user
    
    int* arr = createArray(size, seed);

    // Check if memory allocation was successful
    
    if (!arr) 
    {
        // Print error message if allocation fails
        
        cout << "Memory allocation failed" << endl;
        return 1;
    }

    // Print array and calculate sum and display that to the user
    
    printArray(arr, size);
    total = sumArray(arr, size);
    
    cout << "The sum of the values in the array is " << total << endl;

    // Handle allocated memory
    
    delete[] arr;

    return 0;
}

int* createArray(int size, int seed) 
{
    // Validate size
    
    if (size <= 0) 
    {
        return nullptr;
    }

    // Set random seed
    
    srand(seed);

    // Allocate memory
    
    int* arr = new int[size];

    // Fill array with random numbers from 0 to 19
    
    for (int i = 0; i < size; i++) 
    {
        *(arr + i) = rand() % 20; 
    }

    // Return arr
    
    return arr;
}

// Function to print the elements of an array

void printArray(int* arr, int size) 
{
    // Ensure the array is valid before printing
    
    if (!arr || size <= 0) 
    {
        // Exit function if the array is null
        
        return;
    }

    // Create a pointer to iterate over the array
    
    int* ptr = arr;
    
    // Loop through the array elements
    
    for (int i = 0; i < size; i++) 
    {
        // Print the value pointed to by ptr
        
        cout << *ptr;
        
        // Check if this is not the last element
        
        if (i < size - 1) 
        {
            // Print a space
            
            cout << " ";
        }
        
        // Move to the next element
         
        ptr++;
    }
    
    // Print newline after printing all elements
    
    cout << " " << endl;
}

// Function to calculate the sum of the elements in an array

int sumArray(int *arr, int size) 
{
    // Validate array and size before proceeding
     
    if (!arr || size <= 0) 
    {
        return 0;
    }

    // Initialize sum variable to 0
    
    int sum = 0;
    
    // Create a pointer to traverse the array
    
    int* ptr = arr;
    
    // Pointer to the end of the array
    
    int* end = arr + size;

    // Loop through the array and accumulate sum
     
    while (ptr < end) 
    {
        // Add the value pointed to by ptr to sum
        
        sum += *ptr;
        
        // Move to the next element
        
        ptr++;
    }

    // Return sum
    
    return sum;
}
