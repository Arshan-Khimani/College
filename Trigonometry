/* This program asks the user for an angle in degrees and then converts the angle measurment
to radians and then converts the radians to its cosine, sine, and tangent equivalent. All of these
calculations are then displayed to the user (The degrees, radians, and equivalent trig 
calculations)
*/

#include <iostream>
#include <math.h>
using namespace std;

int main()
{
    //Declaring my variables called PI, radians and degrees as doubles
    //Assigning the variable PI to the actual PI value (3.14159...)
    
    double PI = acos(-1);
    double radians;
    double degrees;
    
    //Asking the user to input the angle in degrees and storing the value in the variable degrees
    
    cout << "Enter an angle in degrees: ";
	cin >> degrees;
	
	//Calculations for the radians variable
	
	radians = (degrees * PI) / 180;
	
	//Printing the results of the calculations to the user and also doing the trig calculations
	
	cout << "The cosine of " << radians << " radians, " << degrees << " degrees, " << "is approximately " << cos(radians) << "\n";
	cout << "The sine of " << radians << " radians, " << degrees << " degrees, " << "is approximately " << sin(radians) << "\n";
	cout << "The tangent of " << radians << " radians, " << degrees << " degrees, " << "is approximately " << tan(radians) << "\n";
}
