/*
Pseudocode:
1. Define a constant SIZE with a value of 100.
2. Define a SelectionSort function to sort an array of integers using the selection sort algorithm.
3. In main():
    Declare an array numberList to hold up to 100 integers.
    Declare a variable numberRec to store the number of elements to be sorted.
    Ask the user how many elements they want to input and validate the input to be between 1 and 100.
    Prompt the user to enter a seed value for random number generation.
    Use srand with the provided seed to initialize the random number generator.
    Populate the array numberList with random numbers between 0 and 49 using rand().
    Display the array of random numbers.
    Call SelectionSort to sort the array.
    Output the sorted array.
4. The SelectionSort function:
    Iterates over the array and selects the minimum element from the unsorted portion.
    Swaps the minimum element with the first unsorted element.
    Repeats until the array is sorted.
*/

#include <iostream>
#include <iomanip>
#include <cstdlib>
#include <ctime>

using namespace std;

// Defining a constant SIZE as 100

#define SIZE 100

// Function to perform selection sort on an array of integers

void SelectionSort(int [], int size);

int main() 
{
    // Declare an array to store up to 10 integers
    
    int numberList[SIZE];
    
    // Variable to store the number of elements entered by the user
    
    int numberRec;
    
    // Ask the user how many elements to sort and storing the response in numberRec

    cout << "How many elements? ";
    cin >> numberRec;

    // Validate that the number of elements is between 1 and SIZE
    
    while(numberRec >= SIZE + 1 || numberRec <= 0) 
    {
        // Error message will be displayed and the question will be reasked to the user
        
        cout << "The number of elements should be less than " << SIZE+1 << " or greater than 0" << endl;
        cout << "How many elements? ";
        cin >> numberRec;
    }

    // Declare a variable to store the seed value for random number generation
    
    int seed;
    
    // Initializing the random number generator with the given seed
    
    cout << "Enter a seed value: ";
    cin >> seed;
    srand(seed);
    
    // Printing the array after populating the value
    
    cout << "The array after populating value is: " << endl;

     // Populate the array with random values between 0 and 49
     
    for(int i = 0; i < numberRec; i++) 
    {
        // Assigning a random number (0 to 49) to each element in the array
        
        numberList[i] = (rand()%50);
        
        // Print each number with a width of 3 for alignment
        
        cout << setw(3) << numberList[i];
    }
    
    // Creating a blank line
    
    cout << endl;

    // Call the SelectionSort function to sort the array
     
    SelectionSort(numberList, numberRec);

    // Print a message for the sorted array
    
    cout << "The sorted array is : " << endl;
    
    // Output the sorted array
    
    for(int i = 0; i < numberRec; i++) 
    {
        // Print each sorted number with a width of 3 for alignment
        
        cout << setw(3) << numberList[i];
    }
    
    // Creating a blank line
    
    cout << endl;

    return 0;
}

void SelectionSort(int numbers[], int size) 
{
    // Variables to store the index of the minimum element and a temporary variable for swapping
    
    int minIndex, temp;
    
    // Outer loop to iterate over the array
    
    for (int i = 0; i < size - 1; i++) 
    {
        // Assume the first unsorted element is the minimum
        
        minIndex = i;
        
        // Inner loop to find the minimum element in the unsorted portion of the array
        
        for (int j = i + 1; j < size; j++) 
        {
            // If the current element is smaller than the current minimum
            
            if (numbers[j] < numbers[minIndex]) 
            {
                // Update the index of the minimum element
                
                minIndex = j;
            }
        }
        
        // Swap the minimum element with the first unsorted element if the minimum element is not already in the correct position
        
        if (minIndex != i) 
        {
            // Store the current element in temp
            
            temp = numbers[i];
            
            // Place the minimum element at the beginning of the unsorted portion
            
            numbers[i] = numbers[minIndex];
            
            // Place the original element at the new position
            
            numbers[minIndex] = temp;
        }
    }
}
