/* This program gets a number of whole numbers from the user and displays the sum of the positive numbers entered and the 
product of the negative numbers entered */

#include <iostream>

using namespace std;

int main() 
{
    // Creating num, sumPositive, productNegative, countPositive, countNegative variables as integers
    
    int num, sumPositive = 0, productNegative = 1, countPositive = 0, countNegative = 0;

    // Asking the user to enter a whole number and storing the input in the num variable
    
    cout << "Enter a whole number [enter 0 to end input]: ";
    cin >> num;

    // As long as the number entered by the user is not 0, this loop will run
    
    while (num != 0) 
    {
        /* If the number entered is greater than 0, this if statement will run and will add num to sumPositive and will increase 
        countPositive by 1 */
        
        if (num > 0) 
        {
            sumPositive += num;
            countPositive++;
        } 
        
        /* If the number entered is less than 0, this statement will run and will add num to productNegative and will increase 
        countNegative by 1 */
        
        else if (num < 0) 
        {
            productNegative *= num;
            countNegative++;
        }
        
        // Asking the user to enter another whole number and storing it in the num variable
        
        cout << "Enter another whole number [enter 0 to end input]: ";
        cin >> num;
    }
    
    // Adding a blank line
    
    cout << endl;
    
    // If countPositive is greater than 1, this statement will run
    
    if (countPositive > 1) 
    {
        cout << countPositive << " positive numbers were entered. Their sum was " << sumPositive << "." << endl << endl;
    } 
    
    // If countPositive is equal to 1, this statement will run
    
    else if (countPositive == 1)
    {
        cout << countPositive << " positive number was entered. It was a " << sumPositive << "." << endl << endl;
    }
    
    // If none of the above statements are true, this will run
    
    else 
    {
        cout << "No positive numbers were entered." << endl << endl;
    }

    // If countNegative is greater than 1, this statement will run
    
    if (countNegative > 1) 
    {
        cout << countNegative << " negative numbers were entered. Their product was " << productNegative << "." << endl;
    } 
    
    // If countNegative is equal to 1, this statement will run
    
    else if (countNegative == 1)
    {
        cout << countNegative << " negative number was entered. It was a " << productNegative << "." << endl;
    }
    
    // If none of the above statements are true, this will run
    
    else 
    {
        cout << "No negative numbers were entered." << endl;
    }

    return 0;
}
